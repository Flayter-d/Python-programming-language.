day = int(input("День недели (1–7): "))
hour = int(input("Час (0–23): "))

# Будни: 1–5, рабочее время с 9 до 17 включительно (час 18 уже нерабочий)
if 1 <= day <= 5 and 9 <= hour <= 17:
    print("Оператор на связи")
# Суббота: день 6, рабочее время с 10 до 14 включительно (час 15 уже нерабочий)
elif day == 6 and 10 <= hour <= 14:
    print("Оператор на связи")
else:
    print("Оставьте заявку, ответим в рабочее время")
